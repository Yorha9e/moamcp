{
  "name": "moamcp",
  "version": "0.1.0",
  "description": "Mailbox-style multi-agent debate hub (MOA) — MCP server",
  "agents": "./agents",
  "skills": ["./skills"],
  "commands": ["./commands"],
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Write|Edit",
      "command": "node ./hooks/tower-write-guard.mjs",
      "timeout": 10
    }
  ],
  "sessionStart": {
    "skill": "using-moamcp"
  },
  "mcpServers": {
    "moamcp": {
      "command": "node",
      "args": ["./dist/server.js"],
      "toolTimeoutMs": 1800000
    }
  }
}
