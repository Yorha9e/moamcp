{
  "name": "moamcp",
  "version": "0.3.1",
  "description": "Mailbox-style multi-agent debate hub, exposed as an MCP server over stdio",
  "type": "module",
  "bin": {
    "moamcp": "dist/server.js"
  },
  "files": [
    "dist",
    "kimi.plugin.json",
    "agents",
    "skills",
    "commands"
  ],
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && node build.js",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "smol-toml": "^1.7.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
